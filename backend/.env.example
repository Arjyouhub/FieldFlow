# ===================================================================
# FieldFlow Backend Production & Development Environment Configuration
# ===================================================================

# Port to listen on (Render / Railway / Heroku will inject PORT automatically)
PORT=5000

# Environment mode: 'development' or 'production'
NODE_ENV=production

# -------------------------------------------------------------------
# MongoDB Database Configuration
# -------------------------------------------------------------------
# Option A: MongoDB Atlas Cloud (Recommended for Production)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/fieldflow?retryWrites=true&w=majority
# Example:
# MONGODB_URI=mongodb+srv://fieldflow_admin:YourStrongPassword123@cluster0.abcde.mongodb.net/fieldflow?retryWrites=true&w=majority

# Option B: Local MongoDB Database (For local testing)
MONGODB_URI=mongodb://localhost:27017/fieldflow

# Connection Pool Settings (Defaults: max 50, min 5)
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=5

# -------------------------------------------------------------------
# Security & JWT Authentication
# -------------------------------------------------------------------
# Generate a strong 64-character random string for production
JWT_SECRET=replace_with_a_very_long_secure_random_key_in_production_2026
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------------
# GPS & Geofence Verification Engine Configuration
# -------------------------------------------------------------------
DEFAULT_RADIUS_METRES=100
MAX_ALLOWED_ACCURACY_METRES=50

# -------------------------------------------------------------------
# CORS Configuration
# -------------------------------------------------------------------
# Comma-separated domains allowed to connect to this API, or '*'
# Example for production: https://fieldflow-admin.vercel.app,https://admin.fieldflow.com
CORS_ORIGIN=*
